#!/usr/bin/env bash
# Bloquea commits locales en main/master.
# Activar una vez: ./scripts/install-git-hooks.sh

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ Commit directo a '$branch' bloqueado."
  echo "   Creá una rama (feature/...) y abrí un PR a main."
  echo "   (Hook: .githooks/pre-commit)"
  exit 1
fi
exit 0
